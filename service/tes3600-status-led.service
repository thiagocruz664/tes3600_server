[Unit]
Description=TES3600 Main Service Status LED
After=multi-user.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/user/tes3600_server
ExecStart=/home/user/tes3600_server/.venv/bin/python /home/user/tes3600_server/hardware/status_led.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
